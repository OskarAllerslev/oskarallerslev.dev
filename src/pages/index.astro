---
import katex from 'katex';
import Layout from '../layouts/Layout.astro';
import RustApiExplorer from '../components/RustApiExplorer.jsx';
import FbmSimulator from '../components/FbmSimulator.jsx';
import GitHubCard from '../components/GitHubCard.jsx';
import LeetCodeCard from '../components/LeetCodeCard.jsx';
import ProfileImageCard from '../components/ProfileImageCard.jsx';
import SamplePaths from '../components/SamplePaths.astro';

const tex = (src: string) => katex.renderToString(src, { displayMode: true, throwOnError: true, output: 'html' });

const timeline = [
	{
		kind: 'Work',
		title: 'Actuarial Software Developer',
		org: 'Festina Finance',
		dates: 'Jul 2026 – Present',
		current: true,
		body: 'Role focusing on financial software, risk management engines, and scalable investment infrastructure.',
	},
	{
		kind: 'Work',
		title: 'Student Actuary, Insurance Insights',
		org: 'PFA Pension',
		dates: 'Nov 2024 – Jun 2026',
		body: 'Developed internal actuarial packages (Lifepack), engineered automated DevOps ETL pipelines, and built quantitative stakeholder reporting tools.',
	},
	{
		kind: 'Education',
		title: 'MSc Actuarial Mathematics',
		org: 'University of Copenhagen',
		dates: 'Sep 2025 – Jun 2027 (exp.)',
		current: true,
		body: 'Focus: Advanced probability, QRM, ML, financial econometrics.',
	},
	{
		kind: 'Education',
		title: 'BSc Actuarial Mathematics',
		org: 'University of Copenhagen',
		dates: 'Sep 2022 – Jun 2025',
		body: 'Thesis: Hybrid insurance pricing framework.<br />Highlight: Fire severity modeling using Extreme Value Theory (EVT).',
	},
];

const languages = ['Java', 'R (Advanced/Package Dev)', 'SQL', 'C++', 'Python', 'LaTeX'];
const tools = ['Git', 'Gradle', 'Azure DevOps', 'VS Code', 'Shiny', 'Tidyverse'];

const quantMath = [
	{
		title: 'Measure-theoretic probability',
		body: 'σ-algebras, filtrations, conditional expectation and martingales — the rigorous footing the rest is built on.',
		formula: tex(String.raw`\mathbb{E}\left[M_t \mid \mathcal{F}_s\right] = M_s,\qquad s \le t`),
	},
	{
		title: 'Brownian motion & Itô calculus',
		body: 'Quadratic variation, Itô’s formula and SDEs — from geometric Brownian motion (the paths at the top) to rough volatility.',
		formula: tex(String.raw`df(t,X_t) = \partial_t f\,dt + \partial_x f\,dX_t + \tfrac{1}{2}\,\partial_{xx} f\,d\langle X\rangle_t`),
	},
	{
		title: 'Arbitrage-free pricing',
		body: 'Risk-neutral valuation under ℚ, change of measure via Girsanov, and Monte Carlo when no closed form exists.',
		formula: tex(String.raw`V_t = \mathbb{E}^{\mathbb{Q}}\!\left[\, e^{-\int_t^T r_s\,ds}\, H \;\middle|\; \mathcal{F}_t \right]`),
	},
	{
		title: 'Life insurance mathematics',
		body: 'Multi-state models and Thiele’s equation for reserves — the math behind Lifepack and the life & pension calculations I implement in Java.',
		formula: tex(String.raw`\tfrac{d}{dt}V(t) = r(t)\,V(t) + \pi(t) - \mu(t)\big(b(t) - V(t)\big)`),
	},
	{
		title: 'Extreme value theory',
		body: 'Peaks-over-threshold with a generalised Pareto tail, used to model fire-claim severity.',
		formula: tex(String.raw`\mathbb{P}(X-u>y \mid X>u) \approx \Big(1+\xi\,\tfrac{y}{\beta}\Big)^{-1/\xi}`),
	},
];
const quantAlso = ['GLM', 'Time Series (Cointegration)', 'Machine Learning'];

const externalIcon =
	'<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M8 7h9v9" /></svg>';
---

<Layout title="Oskar Allerslev | Portfolio">
	<main class="relative z-10">
		<!-- ================= Hero ================= -->
		<section class="relative isolate mx-auto max-w-6xl px-5 pb-24 pt-32 sm:px-8 sm:pt-40" aria-labelledby="hero-title">
			<SamplePaths />
			<div data-hero class="hero-parallax grid grid-cols-1 items-center gap-12 md:grid-cols-[1fr_280px]">
				<div class="space-y-7">
					<div data-reveal class="inline-flex items-center gap-2 rounded-full border border-white/[0.08] bg-white/[0.03] px-3 py-1 font-mono text-[11px] uppercase tracking-[0.18em] text-zinc-400 backdrop-blur">
						<span class="h-1.5 w-1.5 rounded-full bg-teal-400 shadow-[0_0_10px_#2dd4bf]"></span>
						Portfolio
					</div>
					<h1 id="hero-title" data-reveal style="--delay:60ms" class="text-gradient text-[clamp(2.75rem,8vw,5.25rem)] font-extrabold leading-[0.98] tracking-[-0.045em]">
						Oskar Allerslev
					</h1>
					<h2 data-reveal style="--delay:120ms" class="text-xl font-semibold tracking-tight text-zinc-200 sm:text-2xl">
						Quantitative Infrastructure <span class="text-zinc-600">&amp;</span>
						<span class="bg-gradient-to-r from-teal-300 to-violet-300 bg-clip-text text-transparent">Actuarial Engineering</span>
					</h2>
					<p data-reveal style="--delay:180ms" class="max-w-2xl text-[15px] leading-relaxed text-zinc-400 sm:text-base">
						MSc Actuarial Mathematics student at UCPH and Actuarial Software Developer at Festina Finance. I specialize
						in quantitative risk management (QRM), stochastic calculus, and machine learning. My focus
						is translating advanced mathematical theory into scalable, low-latency pricing engines and
						infrastructure using C++, Rust, and R.
					</p>
					<div data-reveal style="--delay:240ms" class="flex flex-wrap items-center gap-3 pt-1">
						<a
							data-magnetic
							href="/CV_Oskar_Allerslev.pdf"
							download="CV_Oskar_Allerslev.pdf"
							class="group inline-flex items-center gap-2 rounded-xl bg-zinc-100 px-4 py-2.5 text-sm font-semibold text-zinc-950 shadow-[0_8px_30px_-12px_rgba(255,255,255,0.5)] transition hover:-translate-y-0.5 hover:bg-white"
						>
							<svg class="h-4 w-4 transition group-hover:translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0-5-5m5 5 5-5M5 20h14" /></svg>
							Download CV (PDF)
						</a>
						<a
							data-magnetic
							href="https://www.linkedin.com/in/oskarallerslev"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm font-medium text-zinc-300 backdrop-blur transition hover:-translate-y-0.5 hover:border-white/20 hover:text-white"
						>
							<svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
							LinkedIn
						</a>
						<button
							type="button"
							data-palette-open
							class="hidden items-center gap-2 rounded-xl px-3 py-2.5 font-mono text-[12px] text-zinc-500 transition hover:text-zinc-300 sm:inline-flex"
						>
							or press <kbd data-kbd class="rounded border border-white/10 bg-white/5 px-1.5 text-[11px] text-zinc-400">Ctrl K</kbd>
						</button>
					</div>
				</div>

				<div data-reveal style="--delay:200ms" class="ring-glow mx-auto h-64 w-64 rounded-[1.75rem] md:ml-auto md:h-[280px] md:w-[280px]">
					<div class="relative h-full w-full overflow-hidden rounded-[calc(1.75rem-1px)] bg-zinc-900">
						<ProfileImageCard />
					</div>
				</div>
			</div>

			<a href="#experience" class="group absolute bottom-2 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-zinc-600 transition hover:text-zinc-300 md:flex" aria-label="Scroll to experience">
				<span class="font-mono text-[10px] uppercase tracking-[0.25em]">Scroll</span>
				<span class="h-8 w-px overflow-hidden bg-white/10">
					<span class="block h-3 w-px animate-[scrollcue_1.8s_ease-in-out_infinite] bg-teal-400"></span>
				</span>
			</a>
		</section>

		<div class="mx-auto max-w-6xl px-5 sm:px-8">
			<!-- ================= 01 Experience ================= -->
			<section id="experience" class="section" aria-labelledby="exp-title">
				<header class="section-head">
					<p class="section-num">01</p>
					<h3 id="exp-title" data-split class="section-title">Experience &amp; Education</h3>
					<p class="section-sub">Industry roles and degrees, newest first.</p>
					<span class="section-meter" aria-hidden="true"><span></span></span>
				</header>

				<ol data-timeline class="relative space-y-4">
					<span class="absolute bottom-6 left-[11px] top-6 w-px bg-white/[0.07]" aria-hidden="true"></span>
					<span data-timeline-fill class="timeline-fill absolute bottom-6 left-[11px] top-6 w-px origin-top bg-gradient-to-b from-teal-300 via-teal-400 to-violet-400" aria-hidden="true"></span>
					{timeline.map((t, i) => (
						<li data-reveal data-timeline-item style={`--delay:${i * 60}ms`} class="relative pl-11">
							<span class="timeline-dot absolute left-0 top-6 grid h-6 w-6 place-items-center rounded-full border border-white/15 bg-zinc-950 transition-all duration-500">
								<span class="h-1.5 w-1.5 rounded-full bg-zinc-500 transition-colors duration-500"></span>
							</span>
							<article data-tilt class="card spotlight p-6">
								<div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
									<h4 class="text-base font-semibold text-zinc-100">{t.title}</h4>
									<span class="shrink-0 font-mono text-[11px] text-zinc-500">{t.dates}</span>
								</div>
								<div class="mt-1.5 flex items-center gap-2 text-[13px] font-medium text-teal-300/90">
									{t.org}
									<span class="rounded-full border border-white/[0.07] px-1.5 py-px font-mono text-[9px] uppercase tracking-wider text-zinc-500">{t.kind}</span>
									{t.current && <span class="rounded-full bg-teal-400/10 px-1.5 py-px font-mono text-[9px] uppercase tracking-wider text-teal-300">Now</span>}
								</div>
								<p class="mt-3 text-[13.5px] leading-relaxed text-zinc-400" set:html={t.body} />
							</article>
						</li>
					))}
				</ol>
			</section>

			<!-- ================= 02 Toolkit ================= -->
			<section id="toolkit" class="section" aria-labelledby="toolkit-title">
				<header class="section-head">
					<p class="section-num">02</p>
					<h3 id="toolkit-title" data-split class="section-title">Core Toolkit</h3>
					<p class="section-sub">What I build with, and the mathematics I build on.</p>
					<span class="section-meter" aria-hidden="true"><span></span></span>
				</header>

				<div class="space-y-4">
					<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
						<div data-reveal data-tilt class="card spotlight p-6">
							<h4 class="card-label"><span class="card-icon">{'{ }'}</span>Languages</h4>
							<div class="flex flex-wrap gap-2">{languages.map((l) => <span class="chip">{l}</span>)}</div>
						</div>
						<div data-reveal style="--delay:70ms" data-tilt class="card spotlight p-6">
							<h4 class="card-label"><span class="card-icon">⌁</span>Tools &amp; Infrastructure</h4>
							<div class="flex flex-wrap gap-2">{tools.map((l) => <span class="chip">{l}</span>)}</div>
						</div>
					</div>

					<div data-reveal class="pt-6">
						<h4 class="card-label mb-4"><span class="card-icon">∑</span>Quantitative Math</h4>
					</div>
					<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
						{quantMath.map((q, i) => (
							<article data-reveal style={`--delay:${(i % 2) * 70}ms`} data-tilt class="card spotlight flex flex-col gap-5 p-6">
								<div>
								<h5 class="text-[15px] font-semibold text-zinc-100">{q.title}</h5>
								<p class="mt-2 text-[13px] leading-relaxed text-zinc-400">{q.body}</p>
								</div>
								<div class="formula no-scrollbar mt-auto overflow-x-auto rounded-xl border border-white/[0.05] bg-black/30 px-3 pt-1 text-zinc-200" set:html={q.formula} />
							</article>
						))}
						<article data-reveal style="--delay:70ms" data-tilt class="card spotlight flex flex-col justify-between gap-4 p-6">
							<div>
								<h5 class="text-[15px] font-semibold text-zinc-100">Statistics &amp; learning</h5>
								<p class="mt-2 text-[13px] leading-relaxed text-zinc-400">Applied daily for pricing, forecasting and reporting.</p>
							</div>
							<div class="flex flex-wrap gap-2">{quantAlso.map((l) => <span class="chip">{l}</span>)}</div>
						</article>
					</div>
				</div>
			</section>

			<!-- ================= 03 Projects ================= -->
			<section id="projects" class="section" aria-labelledby="projects-title">
				<header class="section-head">
					<p class="section-num">03</p>
					<h3 id="projects-title" data-split class="section-title">Featured Infrastructure</h3>
					<p class="section-sub">Open a project to read more and try the live demos.</p>
					<span class="section-meter" aria-hidden="true"><span></span></span>
					<button type="button" data-expand-all class="mt-5 inline-flex items-center gap-2 rounded-lg border border-white/10 bg-white/[0.03] px-3 py-1.5 font-mono text-[11px] text-zinc-400 transition hover:border-white/20 hover:text-zinc-100">
						<span data-expand-label>Expand all</span>
					</button>
				</header>

				<div class="space-y-3" data-accordion>
					<!-- Rust API -->
					<article data-reveal class="project card">
						<button type="button" class="project-trigger" aria-expanded="false" aria-controls="p-rust" id="p-rust-btn">
							<span class="project-index">01</span>
							<span class="min-w-0 flex-1 text-left">
								<span class="block text-[17px] font-semibold text-zinc-100">First Rust API (Stock VaR)</span>
								<span class="mt-1 block font-mono text-[11px] uppercase tracking-wider text-zinc-500">Live API demo</span>
							</span>
							<span class="hidden gap-2 md:flex">{['Rust', 'Axum', 'API'].map((t) => <span class="chip">{t}</span>)}</span>
							<span class="project-plus" aria-hidden="true"></span>
						</button>
						<div class="project-panel" id="p-rust" role="region" aria-labelledby="p-rust-btn">
							<div class="overflow-hidden">
								<div class="space-y-4 px-6 pb-6 sm:pl-[4.75rem]">
									<p class="max-w-3xl text-sm leading-relaxed text-zinc-400">
										A high-performance backend built in Rust using Axum. Fetches ticker data and calculates Historical Value at Risk (VaR) based on continuous returns and empirical quantiles.
									</p>
									<a href="https://github.com/OskarAllerslev/first-rust-api" target="_blank" rel="noopener noreferrer" class="project-link">View on GitHub <span set:html={externalIcon} /></a>
									<RustApiExplorer client:visible />
								</div>
							</div>
						</div>
					</article>

					<!-- Rough vol -->
					<article data-reveal class="project card">
						<button type="button" class="project-trigger" aria-expanded="false" aria-controls="p-rough" id="p-rough-btn">
							<span class="project-index">02</span>
							<span class="min-w-0 flex-1 text-left">
								<span class="block text-[17px] font-semibold text-zinc-100">Rough Volatility Monte Carlo Pricer</span>
								<span class="mt-1 block font-mono text-[11px] uppercase tracking-wider text-zinc-500">Research note</span>
							</span>
							<span class="hidden gap-2 md:flex">{['C++', 'Math', 'SDEs', 'fBM'].map((t) => <span class="chip">{t}</span>)}</span>
							<span class="project-plus" aria-hidden="true"></span>
						</button>
						<div class="project-panel" id="p-rough" role="region" aria-labelledby="p-rough-btn">
							<div class="overflow-hidden">
								<div class="space-y-4 px-6 pb-6 sm:pl-[4.75rem]">
									<p class="max-w-3xl text-sm leading-relaxed text-zinc-400">
										Advanced derivative pricing framework based on fractional Brownian motions (fBM). Solves Stochastic Differential Equations (SDEs) to capture the roughness of electricity spot prices and financial markets.
									</p>
									<a href="https://github.com/OskarAllerslev/Rough-Volatility-Monte-Carlo-Pricer" target="_blank" rel="noopener noreferrer" class="project-link">View on GitHub <span set:html={externalIcon} /></a>
									<FbmSimulator client:visible />
								</div>
							</div>
						</div>
					</article>

					<!-- Nitor -->
					<article data-reveal class="project card">
						<button type="button" class="project-trigger" aria-expanded="false" aria-controls="p-nitor" id="p-nitor-btn">
							<span class="project-index">03</span>
							<span class="min-w-0 flex-1 text-left">
								<span class="block text-[17px] font-semibold text-zinc-100">Nitor Energy Forecasting Competition 2026</span>
								<span class="mt-1 block font-mono text-[11px] uppercase tracking-wider text-zinc-500">Competition</span>
							</span>
							<span class="hidden gap-2 md:flex">{['R', 'tidymodels', 'XGBoost'].map((t) => <span class="chip">{t}</span>)}</span>
							<span class="project-plus" aria-hidden="true"></span>
						</button>
						<div class="project-panel" id="p-nitor" role="region" aria-labelledby="p-nitor-btn">
							<div class="overflow-hidden">
								<div class="space-y-4 px-6 pb-6 sm:pl-[4.75rem]">
									<p class="max-w-3xl text-sm leading-relaxed text-zinc-400">
										Predictive machine learning pipeline forecasting highly volatile energy spot prices across 6 distinct markets. Optimized for RMSE utilizing specialized XGBoost models and domain-specific meteorological features.
									</p>
									<div class="flex flex-wrap gap-2">{['R', 'tidymodels', 'XGBoost', 'Machine Learning'].map((t) => <span class="chip">{t}</span>)}</div>
									<a href="https://github.com/OskarAllerslev/Nitor-energy-competition-2026" target="_blank" rel="noopener noreferrer" class="project-link">View on GitHub <span set:html={externalIcon} /></a>
								</div>
							</div>
						</div>
					</article>

					<!-- Lifepack -->
					<article data-reveal class="project card">
						<button type="button" class="project-trigger" aria-expanded="false" aria-controls="p-lifepack" id="p-lifepack-btn">
							<span class="project-index">04</span>
							<span class="min-w-0 flex-1 text-left">
								<span class="block text-[17px] font-semibold text-zinc-100">Lifepack (R Package)</span>
								<span class="mt-1 block font-mono text-[11px] uppercase tracking-wider text-zinc-500">On CRAN</span>
							</span>
							<span class="hidden gap-2 md:flex">{['R', 'devtools', 'OOP'].map((t) => <span class="chip">{t}</span>)}</span>
							<span class="project-plus" aria-hidden="true"></span>
						</button>
						<div class="project-panel" id="p-lifepack" role="region" aria-labelledby="p-lifepack-btn">
							<div class="overflow-hidden">
								<div class="space-y-4 px-6 pb-6 sm:pl-[4.75rem]">
									<p class="max-w-3xl text-sm leading-relaxed text-zinc-400">
										Comprehensive R package for life insurance mathematics. Implements robust object-oriented programming (OOP), unit testing, and full roxygen2 documentation for production use.
									</p>
									<div class="max-w-2xl overflow-hidden rounded-xl border border-white/[0.06] bg-black/40">
										<div class="flex items-center gap-1.5 border-b border-white/[0.05] px-3 py-2">
											<span class="h-2 w-2 rounded-full bg-zinc-700"></span>
											<span class="h-2 w-2 rounded-full bg-zinc-700"></span>
											<span class="h-2 w-2 rounded-full bg-zinc-700"></span>
											<span class="ml-2 font-mono text-[10px] text-zinc-600">R console</span>
										</div>
										<div class="no-scrollbar overflow-x-auto p-4 font-mono text-[11.5px] leading-relaxed">
											<div class="text-zinc-300"><span class="text-teal-400">&gt;</span> library(lifepack)</div>
											<div class="whitespace-nowrap text-zinc-400"><span class="text-teal-400">&gt;</span> Lambda &lt;- function(x) matrix(c(-0.1, 0.1, 0.05, -0.05), 2, 2)</div>
											<div class="whitespace-nowrap text-zinc-400"><span class="text-teal-400">&gt;</span> R &lt;- function(x, mu) matrix(c(mu, 0, 0, mu), 2, 2)</div>
											<div class="whitespace-nowrap text-zinc-400"><span class="text-teal-400">&gt;</span> equiv_premium(0, 80, Lambda, R, dR, 0.05, 0.03, 100)</div>
											<div class="text-terminal-green">[1] 0.04512</div>
										</div>
									</div>
									<div class="flex flex-wrap items-center gap-3">
										<a href="https://github.com/OskarAllerslev/lifepack" target="_blank" rel="noopener noreferrer" class="project-link">View on GitHub <span set:html={externalIcon} /></a>
										<a href="https://cran.r-project.org/web/packages/lifepack/index.html" target="_blank" rel="noopener noreferrer" class="project-link">CRAN <span set:html={externalIcon} /></a>
									</div>
								</div>
							</div>
						</div>
					</article>
				</div>
			</section>

			<!-- ================= 04 Beyond code ================= -->
			<section id="beyond" class="section" aria-labelledby="beyond-title">
				<header class="section-head">
					<p class="section-num">04</p>
					<h3 id="beyond-title" data-split class="section-title">Beyond Code</h3>
					<p class="section-sub">Optimization outside the terminal.</p>
					<span class="section-meter" aria-hidden="true"><span></span></span>
				</header>
				<div data-reveal data-tilt class="card spotlight relative overflow-hidden p-8 sm:p-10">
					<div class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-teal-400/10 blur-3xl"></div>
					<div class="grid grid-cols-1 items-end gap-8 sm:grid-cols-[auto_1fr]">
						<div>
							<div class="font-mono text-[clamp(3.5rem,10vw,6rem)] font-bold leading-none tracking-tight">

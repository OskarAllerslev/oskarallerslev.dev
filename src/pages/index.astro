<script>
	const reduceMotion = (window.matchMedia('(prefers-reduced-motion: reduce)').matches && !location.search.includes('motion'));

	// ---------- Split section titles into words for a staggered rise ----------
	document.querySelectorAll<HTMLElement>('[data-split]').forEach((el) => {
		const words = (el.textContent ?? '').trim().split(/\s+/);
		el.setAttribute('aria-label', el.textContent?.trim() ?? '');
		el.innerHTML = words
			.map((w, i) => `<span class="split-word" aria-hidden="true"><span style="--i:${i}">${w.replace(/&/g, '&amp;')}</span></span>`)
			.join(' ');
		el.setAttribute('data-reveal', '');
	});
	if (!reduceMotion && 'IntersectionObserver' in window) {
		const io = new IntersectionObserver(
			(entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add('is-visible'), io.unobserve(e.target))),
			{ threshold: 0.2 }
		);
		document.querySelectorAll('[data-split]').forEach((el) => io.observe(el));
	} else {
		document.querySelectorAll('[data-split]').forEach((el) => el.classList.add('is-visible'));
	}

	// ---------- Accordion ----------
	const triggers = [...document.querySelectorAll<HTMLButtonElement>('.project-trigger')];
	const expandAll = document.querySelector<HTMLButtonElement>('[data-expand-all]');
	const expandLabel = document.querySelector<HTMLElement>('[data-expand-label]');
	const syncExpandLabel = () => {
		const allOpen = triggers.every((t) => t.getAttribute('aria-expanded') === 'true');
		if (expandLabel) expandLabel.textContent = allOpen ? 'Collapse all' : 'Expand all';
	};
	const setOpen = (t: HTMLButtonElement, open: boolean) => {
		t.setAttribute('aria-expanded', String(open));
		t.closest('.project')?.classList.toggle('is-open', open);
		const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
		if (panel) panel.inert = !open;
	};
	triggers.forEach((t) => setOpen(t, false));
	triggers.forEach((t) =>
		t.addEventListener('click', () => {
			setOpen(t, t.getAttribute('aria-expanded') !== 'true');
			syncExpandLabel();
		})
	);
	expandAll?.addEventListener('click', () => {
		const open = !triggers.every((t) => t.getAttribute('aria-expanded') === 'true');
		triggers.forEach((t) => setOpen(t, open));
		syncExpandLabel();
	});

	// ---------- Count-up ----------
	document.querySelectorAll<HTMLElement>('[data-count-to]').forEach((el) => {
		const target = parseFloat(el.dataset.countTo ?? '0');
		if (reduceMotion || !('IntersectionObserver' in window)) return;
		el.textContent = '0.00';
		const io = new IntersectionObserver(([e]) => {
			if (!e.isIntersecting) return;
			io.disconnect();
			const t0 = performance.now();
			const dur = 1400;
			const step = (now: number) => {
				const p = Math.min(1, (now - t0) / dur);
				const eased = 1 - Math.pow(1 - p, 4);
				el.textContent = (target * eased).toFixed(2);
				if (p < 1) requestAnimationFrame(step);
			};
			requestAnimationFrame(step);
		}, { threshold: 0.6 });
		io.observe(el);
	});

	// ---------- Scroll-linked effects (single rAF loop) ----------
	const hero = document.querySelector<HTMLElement>('[data-hero]');
	const timeline = document.querySelector<HTMLElement>('[data-timeline]');
	const fill = document.querySelector<HTMLElement>('[data-timeline-fill]');
	const items = [...document.querySelectorAll<HTMLElement>('[data-timeline-item]')];

	let ticking = false;
	const update = () => {
		ticking = false;
		const vh = window.innerHeight;

		if (hero && !reduceMotion) {
			const p = Math.min(1, Math.max(0, window.scrollY / (vh * 0.9)));
			hero.style.setProperty('--hp', p.toFixed(3));
		}

		if (timeline && fill) {
			const r = timeline.getBoundingClientRect();
			const center = vh * 0.6;
			const p = Math.min(1, Math.max(0, (center - r.top) / r.height));
			fill.style.transform = `scaleY(${p})`;
			items.forEach((it) => {
				const dot = it.querySelector('.timeline-dot');
				dot?.classList.toggle('is-past', it.getBoundingClientRect().top + 30 < center);
			});
		}
	};
	const onScroll = () => {
		if (!ticking) {
			ticking = true;
			requestAnimationFrame(update);
		}
	};
	addEventListener('scroll', onScroll, { passive: true });
	addEventListener('resize', onScroll);
	update();
</script>

